# Fast, per-file checks only. Measured on this repo: eslint over one changed
# file is ~4s warm, prettier ~2s. `npm run typecheck` (25s) and
# `npm run test:governance` (27s) are whole-project; a 52s commit encourages
# bypassing the hook with --no-verify, so they stay in the full check and CI.
npx lint-staged
