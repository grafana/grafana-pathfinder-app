{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "banner": {
      "$ref": "#/$defs/__schema0"
    },
    "exitButtonLabel": {
      "$ref": "#/$defs/__schema1"
    },
    "page": {
      "$ref": "#/$defs/__schema2"
    },
    "rules": {
      "$ref": "#/$defs/__schema19"
    }
  },
  "required": ["page", "rules"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/__schema3"
        },
        "width": {
          "$ref": "#/$defs/__schema4"
        },
        "spacing": {
          "$ref": "#/$defs/__schema5"
        },
        "header": {
          "$ref": "#/$defs/__schema6"
        },
        "blocks": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": ["version", "blocks"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "number",
      "const": 1
    },
    "__schema4": {
      "type": "string",
      "enum": ["standard", "wide"]
    },
    "__schema5": {
      "type": "string",
      "enum": ["normal", "spacious"]
    },
    "__schema6": {
      "type": "string",
      "enum": ["standard", "minimal"]
    },
    "__schema7": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hero"
            },
            "variant": {
              "type": "string",
              "enum": ["standard", "banner"]
            },
            "eyebrow": {
              "$ref": "#/$defs/__schema9"
            },
            "title": {
              "$ref": "#/$defs/__schema9"
            },
            "description": {
              "$ref": "#/$defs/__schema9"
            },
            "alignment": {
              "$ref": "#/$defs/__schema10"
            }
          },
          "required": ["type", "title"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "content": {
              "$ref": "#/$defs/__schema9"
            },
            "alignment": {
              "$ref": "#/$defs/__schema10"
            },
            "secondary": {
              "type": "boolean"
            }
          },
          "required": ["type", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "launch-form"
            },
            "ruleId": {
              "$ref": "#/$defs/__schema11"
            },
            "label": {
              "$ref": "#/$defs/__schema9"
            },
            "inputs": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              }
            }
          },
          "required": ["type", "ruleId", "label", "inputs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "$ref": "#/$defs/__schema9"
            },
            "language": {
              "type": "string",
              "enum": ["bash", "text"]
            }
          },
          "required": ["type", "command"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "divider"
            },
            "label": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "guide-links"
            },
            "layout": {
              "type": "string",
              "enum": ["cards", "links"]
            },
            "links": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema18"
              }
            }
          },
          "required": ["type", "layout", "links"],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "__schema10": {
      "type": "string",
      "enum": ["start", "center"]
    },
    "__schema11": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "inputType": {
          "$ref": "#/$defs/__schema13"
        },
        "format": {
          "$ref": "#/$defs/__schema14"
        },
        "variableName": {
          "$ref": "#/$defs/__schema11"
        },
        "prompt": {
          "$ref": "#/$defs/__schema9"
        },
        "placeholder": {
          "$ref": "#/$defs/__schema15"
        },
        "required": {
          "$ref": "#/$defs/__schema16"
        },
        "datasourceFilter": {
          "$ref": "#/$defs/__schema17"
        }
      },
      "required": ["inputType", "variableName", "prompt"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "enum": ["text", "datasource"]
    },
    "__schema14": {
      "type": "string",
      "enum": ["http-origin", "http-url"]
    },
    "__schema15": {
      "$ref": "#/$defs/__schema9"
    },
    "__schema16": {
      "type": "boolean"
    },
    "__schema17": {
      "$ref": "#/$defs/__schema9"
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/__schema11"
        },
        "label": {
          "$ref": "#/$defs/__schema9"
        },
        "description": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": ["ruleId"],
      "additionalProperties": false
    },
    "__schema19": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema20"
      }
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema11"
        },
        "title": {
          "$ref": "#/$defs/__schema9"
        },
        "url": {
          "$ref": "#/$defs/__schema9"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "type": {
          "type": "string"
        },
        "targetUrl": {
          "$ref": "#/$defs/__schema9"
        },
        "page": {
          "$ref": "#/$defs/__schema9"
        },
        "interactiveLearning": {
          "type": "boolean"
        }
      },
      "required": ["id", "title", "url", "description"],
      "additionalProperties": false
    }
  }
}
