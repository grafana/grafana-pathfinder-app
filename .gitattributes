# Ensure shell scripts always use LF line endings on all platforms
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
# Git hooks have no extension, so no rule above covers them. Checked out
# with CRLF they fail to execute.
.husky/* text eol=lf

# Ensure consistent line endings for other text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

